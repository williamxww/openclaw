{
  // Assemble Agent 自身的运行配置
  // 该文件描述 assemble agent 使用的模型、工具和执行约束
  // 不描述它生成的 OPT 的配置（那些由装配流程动态生成）

  "agents": {
    "defaults": {
      "skipBootstrap": true,
      "executionContract": "strict-agentic"
    },
    "list": [
      {
        "id": "assemble",
        "workspace": "~/workspaces/assemble",
        "executionContract": "strict-agentic"
      }
    ]
  },

  "models": {
    "mode": "merge",
    "providers": {
      // 使用平台默认 LLM，由运维在部署时注入
      // 替换为实际 provider 配置
      "platform-default": {
        "baseUrl": "$ENV:PLATFORM_LLM_BASE_URL",
        "api": "openai-completions",
        "apiKey": "$ENV:PLATFORM_LLM_API_KEY",
        "models": [
          {
            "id": "$ENV:PLATFORM_LLM_MODEL_ID",
            "name": "Platform Default LLM",
            "contextWindow": 128000,
            "maxTokens": 8192,
            "input": ["text"],
            "reasoning": false
          }
        ]
      }
    }
  },

  "tools": {
    // mc 是 MinIO 客户端（写蓝图真源）。DAG→Lobster 已在 xsystem 侧完成，本 agent 不需 dag2lobster
    "alsoAllow": ["mc"]
  },

  "skills": {
    "entries": {
      // 每个生成文件一个 CREATE_* SKILL，各自 reference 一份模板
      "CREATE_IDENTITY_MD": { "enabled": true },
      "CREATE_SOUL_MD": { "enabled": true },
      "CREATE_USER_MD": { "enabled": true },
      "CREATE_AGENTS_MD": { "enabled": true },
      "CREATE_TOOLS_MD": { "enabled": true },
      "CREATE_HEARTBEAT_MD": { "enabled": true },
      "CREATE_OPENCLAW_JSON": { "enabled": true },
      "CREATE_KB_SKILL": { "enabled": true },
      "CREATE_ONTOLOGY_SKILL": { "enabled": true },
      "CREATE_PROGRAM_SKILL": { "enabled": true },
      "CREATE_HUB_SKILL": { "enabled": true },
      "CREATE_CRON_JOBS": { "enabled": true },
      "CREATE_WORKFLOW_LOBSTER": { "enabled": true }
    }
  },

  "mcp": {
    "servers": {
      // 如需接入外部模板仓库或配置中心，在此添加 MCP server
    },
    "sessionIdleTtlMs": 300000
  }
}
